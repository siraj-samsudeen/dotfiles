  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude-code-docs/claude-docs-helper.sh hook-check"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/vault-freshness.sh 2>/dev/null || true",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"/Users/siraj/.claude/feather-flow/hooks/check-update.js\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/heal-capture.sh 2>/dev/null || true",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/vault-sync-reminder.sh 2>/dev/null || true",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/vault-autocommit.sh 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "digital-dividend-marketplace": {
      "source": {
        "source": "github",
        "repo": "thlandgraf/cc-marketplace"
      }
    }
  },
  "outputStyle": "default",
  "effortLevel": "xhigh",
  "skipDangerousModePermissionPrompt": false,
  "verbose": false,
  "fileCheckpointingEnabled": false,
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "feedbackSurveyState": {
    "lastShownTime": 1754285015216
  }
}
